# ============================================
# Doon Scholars - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control

# ============================================
# REQUIRED
# ============================================

# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/doon-scholars

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Session Security (generate a random 32+ character string)
SESSION_SECRET=your-secure-random-string-here

# ============================================
# OPTIONAL
# ============================================

# Super Admin Email (user with this email gets super_admin role)
SUPER_ADMIN_EMAIL=admin@doonscholars.com

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Google Gemini AI (for educational AI features)
GOOGLE_API_KEY=...

# Redis (for caching, optional - falls back to in-memory)
REDIS_URL=redis://localhost:6379

# AI Backend URL (default: http://127.0.0.1:8000)
AI_BACKEND_URL=http://127.0.0.1:8000

# Allowed CORS Origin (default: http://localhost:3000)
ALLOWED_ORIGIN=http://localhost:3000

# ============================================
# DEVELOPMENT
# ============================================

# Next.js development URL
NEXT_PUBLIC_DEV_URL=http://localhost:3000

# ============================================
# NOTES
# ============================================
# - Required vars: App won't start without them
# - Optional vars: App works but some features may be limited
# - Never commit this file or .env.local
# - Use .env.example as reference
# - SESSION_SECRET: Used for signing cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
